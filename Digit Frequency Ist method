#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() 
{

    char *s=malloc(100*sizeof(char));
    scanf("%[^\n]",s);
    int i,j,count;
    for(int i=0;i<10;i++)
    {
     count=0;
     for(j=0;s[j]!='\0';j++){
        if(s[j]==48+i)
        count++;
     }
     printf("%d ",count);
    }  
    
    return 0;
}
